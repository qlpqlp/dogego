{
  "manifest_version": 1,
  "id": "dogego.doginals",
  "name": "Doginals / DRC-20 L2",
  "version": "0.8.0",
  "author": "DogeGo",
  "description": "Indexes L1 P2SH Doginals, Ord envelopes, and OP_RETURN. Mint is L2-only (tokens/images/files/ordinals), signed and gossiped via doginals-v1. Does not mint on Dogecoin L1. Does not change consensus.",
  "homepage": "https://github.com/qlpqlp/dogego",
  "repository": "https://github.com/qlpqlp/dogego/tree/main/DogeGo/extensions/catalog/doginals",
  "dogego_min_version": "0.1.0",
  "permissions": ["chain_read", "chain_index", "datadir_write", "rpc_register", "p2p_extension", "ui_panel", "wallet_rpc"],
  "networks": ["mainnet", "testnet"],
  "icon": "icon.png",
  "docs_path": "extensions/catalog/doginals/docs/USER_GUIDE.md",
  "ui": { "status_method": "info" },
  "entry": {
    "type": "subprocess",
    "module": "dogego.doginals",
    "binary": "doginals-ext"
  },
  "capabilities": ["rpc", "indexer", "l2_sync", "p2p", "ui_panel", "doginals", "drc20", "wallet_rpc"],
  "rpc": [
    { "name": "info", "help": "Status, counts, config, and wizard UI workspace." },
    { "name": "listinscriptions", "help": "List recent L1-indexed inscriptions." },
    { "name": "getinscription", "help": "Fetch one L1 inscription by id." },
    { "name": "getcontent", "help": "Fetch L1 inscription media." },
    { "name": "indexrange", "help": "Scan L1 heights into the local index." },
    { "name": "listtokens", "help": "List indexed DRC-20 token summaries." },
    { "name": "gettoken", "help": "Token summary by ticker." },
    { "name": "listbytick", "help": "Events for a ticker." },
    { "name": "previewinscription", "help": "Preview DRC-20 JSON/hex (does not broadcast)." },
    { "name": "inscribe", "help": "Disabled: minting is L2 only." },
    { "name": "mint", "help": "Mint on L2 only (token/image/file/ordinal)." },
    { "name": "mintprepare", "help": "Prepare unsigned L2 mint + sign_message." },
    { "name": "mintcommit", "help": "Commit signed L2 mint." },
    { "name": "mintl2", "help": "Alias of mint (L2)." },
    { "name": "mintp2sh", "help": "Disabled: minting is L2 only." },
    { "name": "listmints", "help": "List signed L2 mints." },
    { "name": "getmint", "help": "Fetch one L2 mint." },
    { "name": "getmintcontent", "help": "Fetch L2 mint media." },
    { "name": "putasset", "help": "Create/update an off-L1 L2 asset." },
    { "name": "getasset", "help": "Fetch L2 asset by id." },
    { "name": "listassets", "help": "List recent L2 assets." },
    { "name": "getconfig", "help": "Extension settings." },
    { "name": "setconfig", "help": "Save extension settings." },
    { "name": "exportbackup", "help": "Export settings backup." },
    { "name": "importbackup", "help": "Restore settings backup." },
    { "name": "syncstatus", "help": "Overlay protocol and index lag." },
    { "name": "getaddress", "help": "DRC-20 balances for an address." },
    { "name": "getaddresshistory", "help": "Event history for address." },
    { "name": "geteventsbytxid", "help": "Events for a transaction id." },
    { "name": "apistatus", "help": "Public API routes for wallets." },
    { "name": "httphandle", "help": "HTTP gateway for /api/ext/dogego.doginals/*." }
  ]
}
